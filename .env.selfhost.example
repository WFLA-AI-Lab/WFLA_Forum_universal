# 服务器完整访问地址。内网试用可以先用 http://；公网正式使用必须是 https://
PUBLIC_ORIGIN=http://192.168.1.10:8888

# 监听地址。0.0.0.0 表示监听所有网卡；只想本机访问可改为 127.0.0.1
HOST=0.0.0.0
PORT=8888

# 数据库与前端目录
WFLA_DB_PATH=data/wfla-wall.sqlite
WFLA_FRONTEND_DIR=public
WFLA_BACKUP_DIR=backups

# 运行环境与站点名
ENVIRONMENT=production
FORUM_NAME=世外墙 WFLA Wall
SESSION_TTL_SECONDS=604800

# 一键配置脚本会自动生成随机值；手工部署时必须填写
AUTH_SESSION_SECRET=

# Cookie。默认跟随 PUBLIC_ORIGIN：https=true，http=false
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# 只有前面确实有可信反向代理/内网穿透时才改为 true；否则保持 false
TRUST_PROXY_HEADERS=false

# Microsoft OAuth 可选；留空表示不启用
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=

# GitHub OAuth 可选；留空表示不启用
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Daily JSONL operation logs
WFLA_LOG_DIR=logs
WFLA_LOG_RETENTION_DAYS=14
