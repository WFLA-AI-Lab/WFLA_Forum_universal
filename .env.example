# Required Cloudflare bindings
D1 database ID must be configured in wrangler.toml.
R2 bucket MEDIA must exist.
AUTH_SESSION_SECRET must be set using: wrangler secret put AUTH_SESSION_SECRET

# Local development
npm install
npm run migrate:local
npm run dev

# Daily JSONL operation logs
WFLA_LOG_DIR=logs
WFLA_LOG_RETENTION_DAYS=14
