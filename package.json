{
  "name": "wfla-wall-backend",
  "version": "0.3.1",
  "description": "WFLA Wall (世外墙) — a self-hosted, skin-pluggable campus forum for Shanghai World Foreign Language Academy, with invite-only onboarding, moderation and audit built in. / 面向上海市世外中学的自托管、可换肤校园论坛，内置邀请制注册、监管与审计。",
  "main": "src/index.ts",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "caddy:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-caddy.ps1",
    "caddy:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-caddy.ps1",
    "caddy:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-with-caddy.ps1",
    "caddy:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-with-caddy.ps1 -CheckOnly",
    "dev": "wrangler dev --var ENVIRONMENT:local --var FRONTEND_ORIGIN:http://localhost:5173",
    "start": "node --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply wfla-wall --local",
    "migrate:remote": "wrangler d1 migrations apply wfla-wall --remote",
    "test": "vitest run",
    "frontend:type-check": "npm --prefix frontend run type-check",
    "frontend:build": "npm --prefix frontend run build",
    "selfhost:dev": "tsx watch src/selfhost/server.ts",
    "selfhost:start": "tsx src/selfhost/server.ts",
    "selfhost:migrate": "node scripts/selfhost-migrate.mjs",
    "selfhost:create-owner": "node scripts/selfhost-create-owner.mjs",
    "selfhost:create-test-user": "node scripts/selfhost-create-test-user.mjs",
    "selfhost:backup": "node scripts/selfhost-backup.mjs",
    "selfhost:build": "npm --prefix frontend run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WFLA-AI-Lab/WFLA_Forum_universal.git"
  },
  "keywords": ["forum", "wfla", "hono", "sqlite", "self-hosted", "campus"],
  "author": "WFLA AI Lab / Computerization",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/WFLA-AI-Lab/WFLA_Forum_universal/issues"
  },
  "homepage": "https://github.com/WFLA-AI-Lab/WFLA_Forum_universal#readme",
  "private": "true",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.5",
    "@vitest/coverage-v8": "^5.0.5",
    "bcryptjs": "^3.0.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "hono": "^4.13.13",
    "sanitize-html": "^2.18.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "better-sqlite3": "^13.0.3",
    "miniflare": "^5.20261019.1-beta",
    "tsx": "^4.23.15"
  }
}
