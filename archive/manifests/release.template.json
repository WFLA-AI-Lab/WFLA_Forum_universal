{
  "checks": [
    "npm run type-check",
    "npm run lint",
    "npm test",
    "npm --prefix frontend run type-check",
    "npm --prefix frontend run build"
  ],
  "backup": {
    "ref": "backups/<file>.sqlite",
    "notes": "",
    "created_at": "YYYY-MM-DDTHH:mm:ssZ"
  },
  "version": "vX.Y.Z",
  "commit": "<40-char-commit>",
  "assets": [],
  "migration": {
    "notes": "",
    "file": "src/migrations/00XX_name.sql",
    "applied": false
  },
  "rollback": {
    "database": "restore from verified backup or forward-fix migration",
    "target_tag": "vX.Y.(Z-1)",
    "code": "git checkout <previous-tag>"
  },
  "contract": {
    "schema": 13,
    "api": "v1",
    "skin": 2
  },
  "tag": "vX.Y.Z",
  "release_date": "YYYY-MM-DD"
}
